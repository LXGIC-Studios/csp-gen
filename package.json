{
  "name": "@lxgicstudios/csp-gen",
  "version": "1.0.0",
  "description": "Crawl any URL, catalog all script, style, image, and font sources, then generate a Content-Security-Policy header. Output for nginx, Express, or meta tag. Audit existing CSP policies.",
  "main": "dist/index.js",
  "bin": {
    "csp-gen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "csp",
    "content-security-policy",
    "security",
    "headers",
    "nginx",
    "express",
    "web-security",
    "cli",
    "xss",
    "generator"
  ],
  "author": "LXGIC Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXGIC-Studios/csp-gen.git"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  },
  "homepage": "https://github.com/LXGIC-Studios/csp-gen#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/LXGIC-Studios"
  },
  "bugs": {
    "url": "https://github.com/LXGIC-Studios/csp-gen/issues"
  }
}
